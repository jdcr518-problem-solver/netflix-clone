TMDB_READ_ACCESS_TOKEN=
STREAMFRAME_SUPPLIER_MEDIA_ORIGINS=
STREAMFRAME_GEO_PROXY_SECRET=

# Development defaults to JSON. Production requires explicit postgres and read URL.
STREAMFRAME_REGISTRY_MODE=json
STREAMFRAME_DATABASE_READ_URL=
# Set only in private operator/migration jobs; never in browser or web runtime.
STREAMFRAME_DATABASE_WRITE_URL=
STREAMFRAME_DATABASE_MIGRATION_URL=
STREAMFRAME_OPERATOR_ID=
# TLS is verified by default. Optional PEM CA certificate; no private key.
STREAMFRAME_DATABASE_CA=
# Only for a loopback development/test PostgreSQL server; prohibited in production.
STREAMFRAME_DATABASE_LOCAL_INSECURE=
