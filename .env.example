TMDB_READ_ACCESS_TOKEN=
# Release-approved SHA-256 of the newly issued application token (production only).
STREAMFRAME_TMDB_APPROVED_SHA256=
STREAMFRAME_SUPPLIER_MEDIA_ORIGINS=
STREAMFRAME_GEO_PROXY_SECRET=

# Development defaults to JSON. Production requires explicit postgres and read URL.
STREAMFRAME_REGISTRY_MODE=json
STREAMFRAME_DATABASE_READ_URL=
# Set only in private operator/migration jobs; never in browser or web runtime.
STREAMFRAME_DATABASE_WRITE_URL=
STREAMFRAME_DATABASE_MIGRATION_URL=
STREAMFRAME_OPERATOR_ID=
# TLS is verified by default. Optional PEM CA certificate; no private key.
STREAMFRAME_DATABASE_CA=
# Only for a loopback development/test PostgreSQL server; prohibited in production.
STREAMFRAME_DATABASE_LOCAL_INSECURE=

# Server and private media gateway only
STREAMFRAME_DELIVERY_ORIGIN=
STREAMFRAME_DELIVERY_KEY=

# Private worker identity. Supply only the matching operator or scheduler block.
STREAMFRAME_PRINCIPAL_KIND=
STREAMFRAME_ACCESS_TOKEN=
STREAMFRAME_SSO_ISSUER=
STREAMFRAME_SSO_AUDIENCE=
STREAMFRAME_SSO_PUBLIC_KEY=
STREAMFRAME_SSO_ROLES=
STREAMFRAME_JOB_ISSUER=
STREAMFRAME_JOB_AUDIENCE=
STREAMFRAME_JOB_PUBLIC_KEY=
STREAMFRAME_JOB_SUBJECT=
STREAMFRAME_POLICY_SHA256=
STREAMFRAME_PACKAGE_DIGESTS=

# Private gateway only. Its storage identity needs read access only.
STREAMFRAME_PLAYER_ORIGIN=
STREAMFRAME_STORAGE_ENDPOINT=
STREAMFRAME_STORAGE_REGION=
STREAMFRAME_STORAGE_BUCKET=
STREAMFRAME_STORAGE_ACCESS_KEY_ID=
STREAMFRAME_STORAGE_SECRET_ACCESS_KEY=
STREAMFRAME_STORAGE_SESSION_TOKEN=
