{
  "name": "streamframe-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sources": "node --experimental-strip-types scripts/sources.ts",
    "test:sources": "node --experimental-strip-types --test scripts/sources.test.ts",
    "dev:admin": "node scripts/local-admin.mjs",
    "sources:sync": "node --conditions=react-server --experimental-strip-types scripts/sync-sources.ts",
    "sources:package": "node --conditions=react-server --experimental-strip-types scripts/import-package.ts",
    "test:importer": "node --conditions=react-server --experimental-strip-types --test scripts/importer.test.ts",
    "test:packages": "node --conditions=react-server --experimental-strip-types --test scripts/supplier-package.test.ts",
    "sources:database": "node --conditions=react-server --experimental-strip-types scripts/database.ts",
    "test:database": "node --conditions=react-server --experimental-strip-types --test scripts/database.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:sources && npm run test:importer && npm run test:packages && npm run test:database && npm run test:delivery && npm run test:security",
    "test:delivery": "node --conditions=react-server --experimental-strip-types --test scripts/media-delivery.test.ts",
    "media:plan": "node --experimental-strip-types scripts/media-plan.ts",
    "media:cost": "node scripts/media-cost.mjs",
    "test:security": "node --conditions=react-server --experimental-strip-types --test scripts/production-security.test.ts",
    "sources:scheduled": "node --conditions=react-server --experimental-strip-types scripts/scheduled.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/lib-storage": "3.1175.0",
    "hls.js": "^1.7.4",
    "jose": "6.2.18",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    }
  }
}
